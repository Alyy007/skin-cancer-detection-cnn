from google.colab import files
import os

# Select the newly trained lightweight model file
file_path = '/content/skin_cancer_lightweight_model.keras'

# Fallback to the streamlit optimized model if it was saved there
if not os.path.exists(file_path):
    file_path = '/content/skin_cancer_cnn_model_streamlit.keras'

if os.path.exists(file_path):
    print(f"Downloading {file_path} ({os.path.getsize(file_path) / (1024*1024):.2f} MB)... ")
    files.download(file_path)
else:
    print("Model file not found. Please run the training cell first to generate the file.")
